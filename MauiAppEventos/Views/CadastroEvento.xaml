<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.CadastroEvento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Lavender">

    <VerticalStackLayout Padding="20" Spacing="5">

        <!-- Cabeçalho -->
        <Label Text="Cadastro de Evento"
               FontFamily="Chewy"
               FontSize="30"
               TextColor="DarkBlue"
               HorizontalOptions="Center"
               Margin="0,10,0,5" />

        <!-- Cartão 1: Dados Gerais -->
        <Frame BackgroundColor="CornflowerBlue" 
               CornerRadius="12" 
               Padding="15" 
               HasShadow="True">
            <VerticalStackLayout Spacing="8">
                <Label Text="Informações Básicas"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"
                       TextColor="DarkBlue"
                       FontSize="16" />

                <Label Text="Nome do Evento:"
                       TextColor="DarkBlue"
                       HorizontalTextAlignment="Center"
                       FontSize="14" />
                <Entry Placeholder="Ex: Casamento de João e Maria"
                       Text="{Binding Nome}"
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       FontAttributes="Bold" />

                <Label Text="Local do Evento:"
                       TextColor="DarkBlue"
                       HorizontalTextAlignment="Center"
                       FontSize="14" />
                <Entry Placeholder="Ex: Auditório Central - São Paulo"
                       Text="{Binding Local}"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!-- Cartão 2: Período (DatePickers com limites inteligentes) -->
        <Frame BackgroundColor="White" CornerRadius="12" Padding="15" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Período do Evento"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"
                       TextColor="DarkBlue"
                       FontSize="16" />

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" HorizontalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Data de Início:"
                               TextColor="DarkBlue"
                               FontSize="14" />
                        <DatePicker x:Name="dtpck_inicio"
                                    Date="{Binding DataInicio}"
                                    DateSelected="dtpck_inicio_DateSelected"
                                    Format="dd/MM/yyyy"
                                    TextColor="Green" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Data de Término:"
                               TextColor="DarkBlue"
                               FontSize="14" />
                        <DatePicker x:Name="dtpck_termino"
                                    Date="{Binding DataTermino}"
                                    DateSelected="dtpck_termino_DateSelected"
                                    Format="dd/MM/yyyy"
                                    TextColor="DarkRed" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Cartão 3: Participantes e Custo -->
        <Frame BackgroundColor="CornflowerBlue" CornerRadius="12" Padding="15" HasShadow="True">
            <VerticalStackLayout Spacing="12">
                <Label Text="Participantes e Investimento"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="DarkBlue"
                       FontSize="16" />

                <!-- Linha 1: Participantes (Coluna 0: Rótulo | Coluna 1: Quantidade com fundo branco | Coluna 2: Stepper) -->
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Participantes:"
                           TextColor="DarkBlue"
                           FontSize="14"
                           VerticalOptions="Center"
                           HorizontalOptions="End" />

                    <!-- Coluna 1: Fundo branco e texto DarkBlue -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="12,4"
                            VerticalOptions="Center">
                        <Label Text="{Binding Value, Source={x:Reference stp_participantes}}"
                               TextColor="DarkBlue"
                               FontAttributes="Bold"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <Stepper x:Name="stp_participantes"
                             Grid.Column="2"
                             Minimum="10"
                             Maximum="200"
                             Increment="10"
                             Value="{Binding NumeroParticipantes}"
                             VerticalOptions="Center" />
                </Grid>

                <!-- Linha 2: Custo por Participante (Coluna 0: Texto alinhado | Coluna 1: Campo reto branco com máscara) -->
                <Grid ColumnDefinitions="*, 120" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Custo por Participante:"
                           TextColor="DarkBlue"
                           FontSize="14"
                           VerticalOptions="Center"
                           HorizontalOptions="End" />

                    <!-- Coluna 1: Contorno reto (StrokeShape Rectangle), fundo branco, fonte DarkBlue -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="DarkBlue"
                            StrokeThickness="0"
                            Padding="4,-1"
                            VerticalOptions="Center">
                        <Entry x:Name="txt_custo"
                               Placeholder="R$ 0,00"
                               PlaceholderColor="Gray"
                               Keyboard="Numeric"
                               TextChanged="txt_custo_TextChanged"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               BackgroundColor="White"
                               TextColor="DarkBlue"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Botão de Ação -->
        <Button Text="Cadastrar Evento"
                Clicked="Button_Clicked"
                BackgroundColor="CornflowerBlue"
                TextColor="DarkBlue"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,20" />

    </VerticalStackLayout>
</ContentPage>